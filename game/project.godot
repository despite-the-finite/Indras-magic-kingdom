; Engine configuration file.
; Indra's Magic Kingdom - Godot 4.7, Compatibility renderer (web friendly).

config_version=5

[application]

config/name="Indra's Magic Kingdom"
config/description="A magical princess adventure for ages 4-6."
run/main_scene="res://src/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.99, 0.86, 0.93, 1)
boot_splash/show_image=false

[autoload]

Events="*res://src/core/events.gd"
Content="*res://src/core/content_db.gd"
Settings="*res://src/core/settings.gd"
GameState="*res://src/core/game_state.gd"
Audio="*res://src/core/audio_manager.gd"
Assets="*res://src/core/asset_library.gd"
Actors="*res://src/core/actor_registry.gd"
Dialogue="*res://src/core/dialogue_system.gd"
Quests="*res://src/core/quest_system.gd"
Hints="*res://src/core/hint_system.gd"
InputRouter="*res://src/core/input_router.gd"
Router="*res://src/core/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.99, 0.86, 0.93, 1)
